#!/bin/bash
# fusionner-audit.sh
# Fusionne une PR d'audit, supprime sa branche, met à jour le local.
# Usage : ./fusionner-audit.sh <numéro-PR>

set -e

if [ -z "$1" ]; then
  echo "Usage : ./fusionner-audit.sh <numéro-PR>"
  exit 1
fi

PR=$1

echo "→ Fusion de la PR #$PR..."
gh pr merge "$PR" --merge --delete-branch

echo "→ Mise à jour de la copie locale..."
git checkout main
git pull origin main

echo "✅ PR #$PR fusionnée, branche distante supprimée, copie locale à jour."
